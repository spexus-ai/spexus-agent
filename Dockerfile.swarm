FROM node:22.19.0-bookworm-slim AS pi-runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @earendil-works/pi-coding-agent@0.84.2 \
    && groupadd --gid 10001 swarm && useradd --uid 10001 --gid 10001 --create-home swarm \
    && mkdir -p /workspace /state && chown 10001:10001 /workspace /state
ENV HOME=/home/swarm
WORKDIR /workspace
USER 10001:10001

FROM golang:1.24.5-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=1 go build -trimpath -o /out/spexus-swarm-coordinator ./cmd/spexus-swarm-coordinator \
    && CGO_ENABLED=1 go build -trimpath -o /out/spexus-swarm-runner ./cmd/spexus-swarm-runner

FROM pi-runtime AS runtime
COPY --from=build /out/spexus-swarm-coordinator /out/spexus-swarm-runner /usr/local/bin/
CMD ["/usr/local/bin/spexus-swarm-coordinator", "serve"]
